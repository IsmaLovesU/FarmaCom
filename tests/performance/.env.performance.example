# URL de la API vista desde el contenedor de k6.
K6_API_URL=http://backend:3000/api

# Usuario ficticio con acceso a la sucursal indicada.
K6_USER_EMAIL=usuario.pruebas@farmacom.test
K6_USER_PASSWORD=reemplazar_con_clave_local
K6_BRANCH_ID=1

# Distribución de los seis usuarios de la prueba de carga.
K6_LOAD_POS_VUS=3
K6_LOAD_MANAGEMENT_VUS=2
K6_LOAD_REPORTS_VUS=1

# Duración total predeterminada: cinco minutos.
K6_LOAD_RAMP_UP=30s
K6_LOAD_STEADY_DURATION=4m
K6_LOAD_RAMP_DOWN=30s

# Fechas opcionales para las consultas del dashboard (YYYY-MM-DD).
# Si se omiten, k6 utiliza los últimos 30 días.
K6_REPORT_DATE_FROM=
K6_REPORT_DATE_TO=
